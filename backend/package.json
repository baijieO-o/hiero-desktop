{
  "name": "hiero-agent",
  "version": "0.3.0",
  "description": "Hiero: a personal agent workbench with an explicit state machine, objective verification and fail-closed Docker execution.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baijieO-o/hiero.git"
  },
  "homepage": "https://github.com/baijieO-o/hiero#readme",
  "bugs": {
    "url": "https://github.com/baijieO-o/hiero/issues"
  },
  "keywords": [
    "agent",
    "state-machine",
    "hiero"
  ],
  "type": "module",
  "bin": {
    "hiero": "dist/src/server.js"
  },
  "files": [
    "dist/src",
    "frontend/dist",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/src/server.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "build:frontend": "npm --prefix frontend run build",
    "desktop": "electron electron/main.cjs",
    "prepack": "npm run build:frontend && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "electron": "^45.3.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cordis": "4.0.0-rc.12",
    "playwright-core": "^1.65.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  }
}
