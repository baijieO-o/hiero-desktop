{
    "name":  "hiero-desktop",
    "version":  "0.2.1",
    "private":  true,
    "description":  "Hiero desktop shell (Electron) that runs the Hiero backend and UI in its own window",
    "main":  "src/main.js",
    "license":  "MIT",
    "scripts":  {
                    "start":  "electron .",
                    "dist":  "electron-builder --win nsis"
                },
    "devDependencies":  {
                            "electron":  "^45.2.2",
                            "electron-builder":  "^26.18.0"
                        },
    "type":  "module",
    "build":  {
                  "appId":  "dev.hiero.desktop",
                  "productName":  "Hiero",
                  "directories":  {
                                      "output":  "dist-app"
                                  },
                  "files":  [
                                "src/**/*",
                                "backend/**/*",
                                "!**/*.map"
                            ],
                  "extraResources":  [

                                     ],
                  "win":  {
                              "target":  [
                                             "nsis"
                                         ]
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true
                           }
              }
}
